<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Typescribe.Desktop.ViewModels"
        x:Class="Typescribe.Desktop.BookStyleEditorWindow"
        x:DataType="vm:BookStyleEditorViewModel"
        x:CompileBindings="True"
        Title="Book Design &amp; LaTeX"
        Width="940" Height="780" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="18">
    <StackPanel Grid.Row="0" Spacing="4" Margin="2,0,2,12">
      <TextBlock Text="Book Design &amp; LaTeX" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Edit the project’s page design, typography, code style, running heads, and LuaLaTeX configuration. Changes are validated before they are applied."
                 Opacity="0.72" TextWrapping="Wrap" />
    </StackPanel>

    <TabControl Grid.Row="1">
      <TabItem Header="Page">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="9" Margin="12">
            <TextBlock Text="Document &amp; page" FontSize="17" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Style name" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding Name, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Document class" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding DocumentClass, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Class options" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding DocumentClassOptions, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Page width (in)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="3" Maximum="20" Increment="0.1" Value="{CompiledBinding PageWidthInches, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Page height (in)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="3" Maximum="24" Increment="0.1" Value="{CompiledBinding PageHeightInches, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Top margin (in)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="0" Maximum="5" Increment="0.05" Value="{CompiledBinding MarginTopInches, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Bottom margin (in)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="0" Maximum="5" Increment="0.05" Value="{CompiledBinding MarginBottomInches, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Inner margin (in)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="0" Maximum="5" Increment="0.05" Value="{CompiledBinding MarginInnerInches, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Outer margin (in)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="0" Maximum="5" Increment="0.05" Value="{CompiledBinding MarginOuterInches, Mode=TwoWay}"/></Grid>
            <CheckBox Content="Include table of contents" IsChecked="{CompiledBinding IncludeTableOfContents, Mode=TwoWay}"/>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="TOC depth" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="0" Maximum="6" Increment="1" Value="{CompiledBinding TableOfContentsDepth, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Number sections through" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="-1" Maximum="6" Increment="1" Value="{CompiledBinding SectionNumberDepth, Mode=TwoWay}"/></Grid>
            <CheckBox Content="Open chapters on right-hand pages" IsChecked="{CompiledBinding OpenChaptersOnRight, Mode=TwoWay}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Typography">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="9" Margin="12">
            <TextBlock Text="Fonts &amp; body text" FontSize="17" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Body font" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding BodyFontFamily, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Heading font" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding HeadingFontFamily, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Monospace font" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding MonospaceFontFamily, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Math font" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding MathFontFamily, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Body size (pt)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="6" Maximum="36" Increment="0.25" Value="{CompiledBinding BodyFontSizePoints, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Line spacing" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="0.8" Maximum="3" Increment="0.05" Value="{CompiledBinding LineSpacing, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Paragraph indent (em)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="0" Maximum="10" Increment="0.1" Value="{CompiledBinding ParagraphIndentEm, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Paragraph spacing (pt)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="0" Maximum="72" Increment="0.5" Value="{CompiledBinding ParagraphSpacingPoints, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Body color" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding BodyColorHex, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Heading color" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding HeadingColorHex, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Link color" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding LinkColorHex, Mode=TwoWay}"/></Grid>
            <CheckBox Content="Justify body text" IsChecked="{CompiledBinding JustifyBody, Mode=TwoWay}"/>
            <CheckBox Content="Use colored hyperlinks" IsChecked="{CompiledBinding ColorLinks, Mode=TwoWay}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Elements">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="9" Margin="12">
            <TextBlock Text="Heading hierarchy" FontSize="17" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Chapter size (pt)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="8" Maximum="72" Increment="0.5" Value="{CompiledBinding ChapterFontSizePoints, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Section size (pt)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="7" Maximum="48" Increment="0.5" Value="{CompiledBinding SectionFontSizePoints, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Subsection size (pt)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="7" Maximum="36" Increment="0.5" Value="{CompiledBinding SubsectionFontSizePoints, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Subsubsection size (pt)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="7" Maximum="30" Increment="0.5" Value="{CompiledBinding SubsubsectionFontSizePoints, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Chapter space before (pt)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="0" Maximum="144" Increment="1" Value="{CompiledBinding ChapterBeforeSpacingPoints, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Chapter space after (pt)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="0" Maximum="144" Increment="1" Value="{CompiledBinding ChapterAfterSpacingPoints, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Section space before (pt)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="0" Maximum="72" Increment="1" Value="{CompiledBinding SectionBeforeSpacingPoints, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Section space after (pt)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="0" Maximum="72" Increment="1" Value="{CompiledBinding SectionAfterSpacingPoints, Mode=TwoWay}"/></Grid>
            <Separator Margin="0,8"/>
            <TextBlock Text="Quotes, lists &amp; notes" FontSize="17" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Quote size (pt)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="6" Maximum="36" Increment="0.25" Value="{CompiledBinding QuoteFontSizePoints, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Quote indent (em)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="0" Maximum="10" Increment="0.1" Value="{CompiledBinding QuoteIndentEm, Mode=TwoWay}"/></Grid>
            <CheckBox Content="Italicize block quotes" IsChecked="{CompiledBinding QuoteItalic, Mode=TwoWay}"/>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="List item spacing (pt)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="0" Maximum="36" Increment="0.5" Value="{CompiledBinding ListItemSpacingPoints, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Caption size (pt)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="5" Maximum="24" Increment="0.25" Value="{CompiledBinding CaptionFontSizePoints, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Footnote size (pt)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="5" Maximum="24" Increment="0.25" Value="{CompiledBinding FootnoteFontSizePoints, Mode=TwoWay}"/></Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Code">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="9" Margin="12">
            <TextBlock Text="Fenced code blocks" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="These values style language-tagged fenced blocks in both the manuscript editor and the published PDF." Opacity="0.72" TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Code size (pt)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="5" Maximum="30" Increment="0.25" Value="{CompiledBinding CodeFontSizePoints, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Background color" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding CodeBackgroundHex, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Text color" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding CodeTextHex, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Keyword color" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding CodeKeywordHex, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="String color" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding CodeStringHex, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Comment color" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding CodeCommentHex, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Frame color" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding CodeFrameHex, Mode=TwoWay}"/></Grid>
            <CheckBox Content="Show line numbers in published code blocks" IsChecked="{CompiledBinding CodeLineNumbers, Mode=TwoWay}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Headers &amp; Footers">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="9" Margin="12">
            <TextBlock Text="Running heads &amp; feet" FontSize="17" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Font size (pt)" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Minimum="5" Maximum="24" Increment="0.25" Value="{CompiledBinding HeaderFooterFontSizePoints, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Header left" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding HeaderLeft, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Header center" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding HeaderCenter, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Header right" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding HeaderRight, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Footer left" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding FooterLeft, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Footer center" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding FooterCenter, Mode=TwoWay}"/></Grid>
            <Grid ColumnDefinitions="220,*"><TextBlock Text="Footer right" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{CompiledBinding FooterRight, Mode=TwoWay}"/></Grid>
            <CheckBox Content="Show page numbers" IsChecked="{CompiledBinding ShowPageNumbers, Mode=TwoWay}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Advanced LaTeX">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="9" Margin="12">
            <TextBlock Text="LuaLaTeX" FontSize="17" FontWeight="SemiBold" />
            <CheckBox Content="Enable microtypographic protrusion and expansion" IsChecked="{CompiledBinding EnableMicrotype, Mode=TwoWay}"/>
            <CheckBox Content="Aggressively avoid widows and orphans" IsChecked="{CompiledBinding AvoidWidowsAndOrphans, Mode=TwoWay}"/>
            <TextBlock Text="Additional packages" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <TextBlock Text="Separate package names with commas or new lines. Typescribe automatically suppresses legacy amssymb/amsfonts when unicode-math is active." Opacity="0.72" TextWrapping="Wrap"/>
            <TextBox Text="{CompiledBinding ExtraPackages, Mode=TwoWay}" AcceptsReturn="True" AcceptsTab="True" MinHeight="100" TextWrapping="Wrap" FontFamily="monospace"/>
            <TextBlock Text="Custom preamble" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <TextBlock Text="Advanced LuaLaTeX commands inserted before the document begins. Package declarations are normalized by Typescribe’s safe LuaLaTeX renderer." Opacity="0.72" TextWrapping="Wrap"/>
            <TextBox Text="{CompiledBinding CustomPreamble, Mode=TwoWay}" AcceptsReturn="True" AcceptsTab="True" MinHeight="220" TextWrapping="NoWrap" FontFamily="monospace"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="2" Text="{CompiledBinding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" Margin="4,10,4,0" />

    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,12,0,0">
      <Button Grid.Column="0" Content="Reset Defaults" Click="ResetClicked" MinWidth="110"/>
      <Button Grid.Column="2" Content="Cancel" Click="CancelClicked" MinWidth="90" Margin="0,0,8,0"/>
      <Button Grid.Column="3" Content="Apply" Click="ApplyClicked" MinWidth="90" Margin="0,0,8,0"/>
      <Button Grid.Column="4" Content="Save &amp; Close" Click="SaveClicked" MinWidth="120" Classes="primary"/>
    </Grid>
  </Grid>
</Window>
