<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="TsAppBackgroundBrush" Color="#F3F5F8" />
          <SolidColorBrush x:Key="TsSurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TsSurfaceMutedBrush" Color="#F0F2F6" />
          <SolidColorBrush x:Key="TsSurfaceHoverBrush" Color="#E8EBF1" />
          <SolidColorBrush x:Key="TsEditorBrush" Color="#FBFCFD" />
          <SolidColorBrush x:Key="TsBorderBrush" Color="#D8DDE6" />
          <SolidColorBrush x:Key="TsTextBrush" Color="#202633" />
          <SolidColorBrush x:Key="TsMutedTextBrush" Color="#687386" />
          <SolidColorBrush x:Key="TsAccentBrush" Color="#5965D8" />
          <SolidColorBrush x:Key="TsAccentHoverBrush" Color="#4D58C4" />
          <SolidColorBrush x:Key="TsAccentSoftBrush" Color="#E9EBFF" />
          <SolidColorBrush x:Key="TsDangerBrush" Color="#C64B59" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="TsAppBackgroundBrush" Color="#111419" />
          <SolidColorBrush x:Key="TsSurfaceBrush" Color="#181C22" />
          <SolidColorBrush x:Key="TsSurfaceMutedBrush" Color="#20252E" />
          <SolidColorBrush x:Key="TsSurfaceHoverBrush" Color="#2A303B" />
          <SolidColorBrush x:Key="TsEditorBrush" Color="#15191F" />
          <SolidColorBrush x:Key="TsBorderBrush" Color="#303744" />
          <SolidColorBrush x:Key="TsTextBrush" Color="#F0F3F7" />
          <SolidColorBrush x:Key="TsMutedTextBrush" Color="#9EA8B9" />
          <SolidColorBrush x:Key="TsAccentBrush" Color="#8791FF" />
          <SolidColorBrush x:Key="TsAccentHoverBrush" Color="#9AA3FF" />
          <SolidColorBrush x:Key="TsAccentSoftBrush" Color="#293052" />
          <SolidColorBrush x:Key="TsDangerBrush" Color="#F27D89" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window.typescribe-studio">
    <Setter Property="Background" Value="{DynamicResource TsAppBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TsTextBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Window.typescribe-studio Menu">
    <Setter Property="Background" Value="{DynamicResource TsSurfaceBrush}" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <Style Selector="Window.typescribe-studio MenuItem">
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="Window.typescribe-studio WrapPanel.toolbar-panel">
    <Setter Property="Background" Value="{DynamicResource TsSurfaceBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio WrapPanel.toolbar-panel Button">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="{DynamicResource TsSurfaceMutedBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio Grid.status-panel">
    <Setter Property="Background" Value="{DynamicResource TsSurfaceBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio Grid.status-panel TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource TsMutedTextBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio Button">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="11,6" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource TsBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource TsSurfaceMutedBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource TsSurfaceHoverBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio Button.primary">
    <Setter Property="Background" Value="{DynamicResource TsAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TsAccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Window.typescribe-studio Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource TsAccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TsAccentHoverBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio Button.compact">
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Padding" Value="7,5" />
  </Style>

  <Style Selector="Window.typescribe-studio Button.explorer-tool-button">
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TsMutedTextBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio Button.explorer-tool-button:pointerover">
    <Setter Property="Background" Value="{DynamicResource TsSurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TsTextBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio TextBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="BorderBrush" Value="{DynamicResource TsBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource TsSurfaceBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource TsAccentBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio TextBox.document-title-editor">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="2,1" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Window.typescribe-studio TextBox.document-title-editor:focus">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="{DynamicResource TsSurfaceMutedBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio TextBox.editor-canvas">
    <Setter Property="Background" Value="{DynamicResource TsEditorBrush}" />
    <Setter Property="Padding" Value="30,24" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <Style Selector="Window.typescribe-studio TextBox.editor-canvas:disabled">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Background" Value="{DynamicResource TsEditorBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TsMutedTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TsBorderBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="3" />
  </Style>

  <Style Selector="Window.typescribe-studio ListBoxItem">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Margin" Value="2,1" />
  </Style>

  <Style Selector="Window.typescribe-studio ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource TsSurfaceHoverBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource TsAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TsTextBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio TreeView.project-explorer-tree">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2" />
  </Style>

  <Style Selector="Window.typescribe-studio TreeView.project-explorer-tree TreeViewItem">
    <Setter Property="MinHeight" Value="25" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TsTextBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio TreeView.project-explorer-tree TreeViewItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource TsSurfaceHoverBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio TreeView.project-explorer-tree TreeViewItem:selected">
    <Setter Property="Background" Value="{DynamicResource TsAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TsTextBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio Grid.project-explorer-toolbar">
    <Setter Property="Background" Value="{DynamicResource TsSurfaceBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio TabControl">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Window.typescribe-studio TabItem">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="2,2,2,0" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Window.typescribe-studio TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource TsAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource TsAccentSoftBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Window.typescribe-studio TabControl.sidebar-tabs TabItem">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <Style Selector="Window.typescribe-studio TabControl.inspector-tabs TabItem">
    <Setter Property="Width" Value="102" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="3,2" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <Style Selector="Window.typescribe-studio TabControl.center-tabs TabItem">
    <Setter Property="Width" Value="112" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="112" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="Window.typescribe-studio TabControl.center-tabs TabItem:selected">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TsTextBrush}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="Window.typescribe-studio ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource TsAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource TsSurfaceMutedBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio Border.panel-surface">
    <Setter Property="Background" Value="{DynamicResource TsSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TsBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>

  <Style Selector="Window.typescribe-studio Border.navigator-pane">
    <Setter Property="Background" Value="{DynamicResource TsSurfaceBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio Border.inspector-pane">
    <Setter Property="Background" Value="{DynamicResource TsSurfaceBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio Border.card-surface">
    <Setter Property="Background" Value="{DynamicResource TsSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TsBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
  </Style>

  <Style Selector="Window.typescribe-studio Border.editor-empty-state">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Window.typescribe-studio TextBlock.section-title">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Window.typescribe-studio TextBlock.empty-state-title">
    <Setter Property="Foreground" Value="{DynamicResource TsTextBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio TextBlock.field-label">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource TsMutedTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Window.typescribe-studio TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TsMutedTextBrush}" />
  </Style>

  <Style Selector="Window.typescribe-studio GridSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Window.typescribe-studio GridSplitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource TsAccentBrush}" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>
</Styles>
