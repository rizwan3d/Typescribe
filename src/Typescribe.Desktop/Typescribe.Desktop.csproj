<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IsAotCompatible>true</IsAotCompatible>
    <OptimizationPreference>Speed</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>Typescribe</AssemblyName>
    <RootNamespace>Typescribe.Desktop</RootNamespace>
    <ApplicationTitle>Typescribe</ApplicationTitle>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Typescribe.Domain/Typescribe.Domain.csproj" />
    <ProjectReference Include="../Typescribe.Application/Typescribe.Application.csproj" />
    <ProjectReference Include="../Typescribe.Infrastructure/Typescribe.Infrastructure.csproj" />
  </ItemGroup>
  <Target Name="EnsureBundledPublishingEngine"
          BeforeTargets="PrepareForPublish"
          Condition="'$(Configuration)' == 'Release' and !Exists('../Typescribe.Infrastructure/tools/typst') and !Exists('../Typescribe.Infrastructure/tools/typst.exe')">
    <Error Text="Release publishing requires a pinned Typst binary. Run scripts/fetch-typst.sh or scripts/fetch-typst.ps1 first." />
  </Target>
</Project>
